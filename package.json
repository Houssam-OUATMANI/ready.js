{
  "name": "ready",
  "version": "1.0.0",
  "description": "Zero-dependency, full TypeScript, multi-runtime micro-framework for RESTful JSON APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/test/*.test.js",
    "test:source": "node --test --experimental-strip-types test/*.test.ts",
    "dev:bun": "bun run example/server.ts",
    "dev:node": "node --experimental-strip-types example/server.ts"
  },
  "keywords": [
    "microframework",
    "api",
    "rest",
    "json",
    "typescript",
    "node",
    "bun",
    "deno",
    "zero-dependency"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
